# Pipeline intermediates -- fully reproducible via pipeline/*.py scripts,
# no need to version raw downloads / preview images / boundary extracts.
# The final *.sectors.json files that matter are already in src/data/.
pipeline/data/circuits/*.geojson
pipeline/data/circuits/*.xy.json
pipeline/data/circuits/*_preview.png
pipeline/data/circuits/*.boundaries.json
pipeline/data/circuits/*.sectors.json

# Python cache from the pipeline scripts
__pycache__/
*.pyc
