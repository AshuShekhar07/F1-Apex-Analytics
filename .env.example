# Copy to .env and fill in. .env is gitignored.

# PostgreSQL connection used by the API and all pipeline scripts.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/apex21

# FastF1 on-disk cache. Defaults to ./cache in the repo root when unset.
# FASTF1_CACHE_DIR=/absolute/path/to/cache

# Set to 1 to run the real-data regression tests (tests/real_db/) against DATABASE_URL.
# APEX21_REAL_DB_TESTS=1
