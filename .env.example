# Copy to .env and fill in. .env is gitignored.

# PostgreSQL connection used by the API and all pipeline scripts.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/apex21

# FastF1 on-disk cache. Defaults to ./cache in the repo root when unset.
# FASTF1_CACHE_DIR=/absolute/path/to/cache

# Set to 1 to run the real-data regression tests (tests/real_db/) against DATABASE_URL.
# APEX21_REAL_DB_TESTS=1

# --- production (docker-compose / hosting) ---
# APP_ENV=production                        # turns on the production defaults below
# CORS_ORIGINS=https://your-site.example     # comma-separated origins allowed to call the API
# SERVE_BRAND_ASSETS=false                   # team logos / driver photos (F1/team property): off in production
# RATE_LIMIT_PER_MINUTE=600                  # per client IP; 0 = off (a race page makes ~17 calls)
# WHAT_IF_MAX_SIMS=2000
# WARM_CACHES=true                           # load strategy history at startup
# RESPONSE_CACHE=true                        # keep GET answers in the database per data version (on in production)
# RESPONSE_CACHE_STALE=true                  # after new data, send the last saved answer while it is computed again
# POSTGRES_PASSWORD=change-me                # docker-compose database password
# API_PORT=8000
